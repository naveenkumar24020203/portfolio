# Copy to .env.local and fill in to override the committed defaults.

# EmailJS — public browser identifiers for the contact form.
# https://dashboard.emailjs.com/admin
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Canonical origin, used for metadataBase and absolute Open Graph URLs.
# Optional on Vercel, which falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=
